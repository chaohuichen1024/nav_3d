<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="base_2d_laser" params="name:=base_laser parent_link:=base_link *origin">
        <joint name="${name}_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent_link}"/>
            <child link="${name}"/>
        </joint>
        
        <link name="${name}">
            <inertial>
                <mass value="0.2"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
            <visual>
                <!-- 调整坐标系：绕z轴旋转180度使x轴朝后 -->
                <origin rpy="0 0 ${M_PI}" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.04" length="0.04"/>
                </geometry>
                <material name="red">
                    <color rgba="1 0 0 1"/>
                </material>
            </visual>
            <collision>
                <origin rpy="0 0 ${M_PI}" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.04" length="0.04"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>
</robot>
