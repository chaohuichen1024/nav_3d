<launch>
    <arg name="sensor" default="robosense" />
    <arg name="rviz" default="true" />
    <arg name="octomap_resolution" default="0.2" />

    <include file="$(find fast_lio)/launch/mapping_$(arg sensor).launch">
        <arg name="rviz" value="false" />
    </include>

    <node name="octomap_builder" pkg="octo_planner_3d" type="octomap_builder_node" output="screen">
        <param name="resolution" type="double" value="$(arg octomap_resolution)" />
        <param name="min_points_per_voxel" type="int" value="1" />
        <param name="min_cluster_voxels" type="int" value="1" />
        <param name="pointcloud_topic" type="string" value="/cloud_registered" />
        <param name="octomap_topic" type="string" value="/octomap" />
        <param name="downsample_leaf_size" type="double" value="0.1" />
        <param name="realtime_mode" type="bool" value="true" />
    </node>

    <node name="global_planner" pkg="octo_planner_3d" type="global_planner_node" output="screen">
        <param name="robot_radius" type="double" value="0.20" />
        <param name="max_iterations" type="int" value="250000" />
        <param name="snap_search_radius_cells" type="int" value="8" />
        <param name="require_ground_support" type="bool" value="true" />
        <param name="strict_direct_ground_support" type="bool" value="true" />
        <param name="ground_support_xy_radius_cells" type="int" value="1" />
        <param name="ground_support_depth_cells" type="int" value="2" />
        <param name="enable_preblocked_costmap" type="bool" value="true" />
        <param name="preblocked_costmap_radius_cells" type="int" value="3" />
        <param name="preblocked_costmap_weight" type="double" value="1.5" />
        <param name="lowest_traversable_only" type="bool" value="false" />
        <param name="octomap_topic" type="string" value="/octomap" />
        <param name="path_topic" type="string" value="path" />
        <param name="path_marker_topic" type="string" value="path_marker" />
    </node>

    <group if="$(arg rviz)">
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(find octo_planner_3d)/config/octo_planner.rviz" output="screen" />
    </group>
</launch>